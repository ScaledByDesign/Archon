# Zoi GPU-AI Stack Port Mapping
LITELLM_PORT=7010
AUTOROUTER_PORT=7020
VLLM_PORT=7030
OLLAMA_PORT=7040
QDRANT_PORT=7050
FLOWSIE_PORT=7060

# ===== LiteLLM Configuration =====
# Authentication & Security
LITELLM_MASTER_KEY="sk-wqn0xwq_vha4MVM2yzw" # Your master key for the proxy server. Can use this to send /chat/completion requests etc
LITELLM_SALT_KEY="sk-gjfmpx3zpw2CWG_hau" # Can NOT CHANGE THIS ONCE SET - It is used to encrypt/decrypt credentials stored in DB. If value of 'LITELLM_SALT_KEY' changes your models cannot be retrieved from DB

# Database Configuration - Local PostgreSQL for persistence
DATABASE_URL="postgresql://litellm:litellm_password123@localhost:7063/litellm"
POSTGRES_PRISMA_URL="postgresql://litellm:litellm_password123@localhost:7063/litellm"

# PostgreSQL Settings
POSTGRES_PORT=7063

# Redis Cache Settings
REDIS_PORT=7064
REDIS_URL="redis://localhost:7064"

# ===== LiteLLM Server Settings =====
# Logging & Debugging
LITELLM_LOG_LEVEL="INFO"
LITELLM_SET_VERBOSE="True"
LITELLM_JSON_LOGS="True"

# UI Configuration
LITELLM_UI="True"  # Enable the web UI
LITELLM_UI_USERNAME="admin"  # Optional: Set UI username
LITELLM_UI_PASSWORD="admin123"  # Optional: Set UI password

# Performance & Limits
LITELLM_REQUEST_TIMEOUT=600  # Request timeout in seconds
LITELLM_MAX_BUDGET=100  # Optional: Set budget limits
LITELLM_BUDGET_DURATION="30d"  # Budget duration

# ===== Model Provider API Keys =====
# Add your API keys here as needed
# OPENAI_API_KEY="your-openai-key-here"
# ANTHROPIC_API_KEY="your-anthropic-key-here"
# GOOGLE_API_KEY="your-google-key-here"
# AZURE_API_KEY="your-azure-key-here"
# COHERE_API_KEY="your-cohere-key-here"

# ===== Model Storage Configuration =====
# Centralized model storage location
MODELS_PATH=D:/models
OLLAMA_MODELS=D:/models/ollama
HF_HOME=D:/models/huggingface
TRANSFORMERS_CACHE=D:/models/huggingface/transformers
HF_DATASETS_CACHE=D:/models/huggingface/datasets

# ===== vLLM Configuration =====
VLLM_MODEL_PATH=D:/models/vllm
VLLM_CACHE_DIR=D:/models/vllm/cache

# ===== Optional: Hugging Face Token =====
# HF_TOKEN="your-huggingface-token-here"  # For downloading models from HF Hub

# ===== Docker Cache Configuration =====
# Enable Docker BuildKit for better caching
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Docker cache settings
DOCKER_CACHE_FROM=true
DOCKER_CACHE_TO=true



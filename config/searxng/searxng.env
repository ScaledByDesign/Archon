# SearXNG Configuration
DOMAIN=zoi.local

# Instance Configuration
SEARXNG_HOSTNAME=search.zoi.local
SEARXNG_BASE_URL=http://search.zoi.local

# Security Configuration
SEARXNG_SECRET_KEY=${SEARXNG_SECRET_KEY:-searxng-secret-key-2024-change-me}

# Redis Configuration (for caching)
SEARXNG_REDIS_URL=redis://redis:6379/1

# Morty Proxy Configuration (optional)
SEARXNG_MORTY_URL=
SEARXNG_MORTY_KEY=

# Rate Limiting
SEARXNG_LIMITER=false
SEARXNG_REDIS_URL_LIMITER=redis://redis:6379/2

# Logging Configuration
SEARXNG_LOG_LEVEL=WARNING

# UI Configuration
SEARXNG_AUTOCOMPLETE=google
SEARXNG_DEFAULT_LOCALE=en
SEARXNG_DEFAULT_THEME=simple

# Search Configuration
SEARXNG_SAFE_SEARCH=0
SEARXNG_DEFAULT_SAFESEARCH=0

# Privacy Configuration
SEARXNG_DOI_RESOLVER=oadoi.org
SEARXNG_DEFAULT_DOI_RESOLVER=oadoi.org

# Performance Configuration
SEARXNG_REQUEST_TIMEOUT=3.0
SEARXNG_MAX_REQUEST_TIMEOUT=10.0

# User Agent
SEARXNG_USERAGENT_SUFFIX=

# Image Proxy
SEARXNG_IMAGE_PROXY=false

# HTTP Configuration
SEARXNG_HTTP_PROTOCOL_VERSION=1.1
SEARXNG_POOL_CONNECTIONS=100
SEARXNG_POOL_MAXSIZE=20

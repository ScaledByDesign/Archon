# SuperAGI Backend Configuration
POSTGRES_URL=postgresql://superagi:${PG_PASS}@postgres:5432/superagi
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
DATABASE_URL=postgresql://superagi:${PG_PASS}@postgres:5432/superagi
ENCRYPTION_KEY=${ENCRYPTION_KEY}
EXTERNAL_RESOURCE_DIR=${EXTERNAL_RESOURCE_DIR}
SUPERAGI_SECRET_KEY=${SUPERAGI_SECRET_KEY}
SUPERAGI_ADMIN_EMAIL=${SUPERAGI_ADMIN_EMAIL}
SUPERAGI_ADMIN_PASSWORD=${SUPERAGI_ADMIN_PASSWORD}
ENV=DEV
TZ=America/Chicago

# Qdrant Vector Database Configuration  
QDRANT_HOST_NAME=qdrant
QDRANT_PORT=6333

# LiteLLM Configuration
LITELLM_API_BASE=http://litellm:4000
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}

# OpenAI API Key for LiteLLM (use LiteLLM master key as proxy)
OPENAI_API_KEY=${LITELLM_MASTER_KEY}

ENV=DEV
# FastAPI Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD:-change-me-redis-pass}
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD:-change-me-redis-pass}@redis:6379/0
# Alternative formats for troubleshooting
REDIS_DSN=redis://default:${REDIS_PASSWORD:-change-me-redis-pass}@redis:6379/0
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=${PG_PASS:-postgres}
POSTGRES_DB=fastapi
MONGODB_URI=mongodb://${MONGO_USER:-admin}:${MONGO_PASS:-change-me-mongo-pass}@mongo:27017
MONGODB_URL=mongodb://${MONGO_USER:-admin}:${MONGO_PASS:-change-me-mongo-pass}@mongo:27017/rag_system
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_USERNAME=${MONGO_USER:-admin}
MONGODB_PASSWORD=${MONGO_PASS:-change-me-mongo-pass}
MONGODB_DATABASE=rag_system
QDRANT_URL=http://qdrant:6333
RABBITMQ_URL=amqp://${RABBITMQ_USER:-admin}:${RABBITMQ_PASS:-secretpass}@rabbitmq:5672
LITELLM_URL=${LITELLM_URL:-http://litellm:4000}
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY:-sk-change-me-to-random-string}
AUTHENTIK_URL=${AUTHENTIK_URL:-https://authentik-server:9443}
INSTANCE_ID=1
FASTAPI_OAUTH_CLIENT_ID=${FASTAPI_OAUTH_CLIENT_ID:-}
FASTAPI_OAUTH_CLIENT_SECRET=${FASTAPI_OAUTH_CLIENT_SECRET:-}
FASTAPI_OAUTH_REDIRECT_URI=${FASTAPI_OAUTH_REDIRECT_URI:-}
SESSION_SECRET_KEY=${SESSION_SECRET_KEY:-}
JWT_SECRET_KEY=${JWT_SECRET_KEY:-your-jwt-secret-key-change-in-production}
JWT_ALGORITHM=${JWT_ALGORITHM:-RS256}
JWT_EXPIRATION_TIME=${JWT_EXPIRATION_TIME:-3600}
JWT_REFRESH_EXPIRATION_TIME=${JWT_REFRESH_EXPIRATION_TIME:-86400}
JWT_ISSUER=${JWT_ISSUER:-rag-system}
JWT_AUDIENCE=${JWT_AUDIENCE:-rag-system-api}
OAUTH_PROVIDER_URL=${OAUTH_PROVIDER_URL:-https://authentik-server:9443}
OAUTH_SCOPE=${OAUTH_SCOPE:-openid email profile rag:api}
CORS_ORIGINS=${CORS_ORIGINS:-http://localhost:3000,http://localhost:8080,http://localhost:8000}
TRUSTED_HOSTS=${TRUSTED_HOSTS:-localhost,127.0.0.1,*.localhost}
TZ=America/Chicago

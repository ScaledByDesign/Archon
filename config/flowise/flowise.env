# Flowise Configuration
DOMAIN=zoi.local

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=flowise
DATABASE_PASSWORD=${PG_PASS:-secretpass}
DATABASE_NAME=flowise

# Service Configuration
PORT=3000
HOST=0.0.0.0

# Security
FLOWISE_SECRETKEY_OVERWRITE=${FLOWISE_SECRET_KEY:-flowise-secret-key-2024}

# File Upload
FLOWISE_FILE_SIZE_LIMIT=50mb

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://flowise.zoi.local,http://localhost:3000

# Tool Configuration
TOOL_FUNCTION_BUILTIN_DEP=crypto,fs,path
TOOL_FUNCTION_EXTERNAL_DEP=axios,cheerio,moment

# LangSmith Integration (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=${LANGCHAIN_API_KEY:-}
LANGCHAIN_PROJECT=flowise-zoi

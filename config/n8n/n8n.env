# n8n Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=${PG_PASS:-secretpass}

# User credentials
N8N_ADMIN_EMAIL=${N8N_ADMIN_EMAIL:-admin@zoi.cc}
N8N_ADMIN_PASSWORD=${N8N_ADMIN_PASSWORD:-admin123!}
N8N_ADMIN_FIRSTNAME=${N8N_ADMIN_FIRSTNAME:-Admin}
N8N_ADMIN_LASTNAME=${N8N_ADMIN_LASTNAME:-Istrator}

# Disable basic auth - using Authentik for UI authentication
N8N_BASIC_AUTH_ACTIVE=false

# Note: n8n requires its own authentication after Authentik forward auth
# Use admin@zoi.cc / admin123! to log in

# Disable secure cookies for local HTTP development
N8N_SECURE_COOKIE=false

# Email Configuration
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=${N8N_SMTP_USER:-your-email@gmail.com}
N8N_SMTP_PASS=${N8N_SMTP_PASS:-your-smtp-app-password}
N8N_SMTP_SENDER=${N8N_SMTP_SENDER:-n8n@zoi.local}

# Host Configuration
N8N_HOST=n8n.${DOMAIN:-zoi.local}
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.${DOMAIN:-zoi.local}/

# Timezone
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago

# Security - Allow webhook and API access without authentication
N8N_SECURITY_AUDIT_DAYS=7

# OAuth2 Configuration for Authentik Integration (for n8n credentials)
N8N_OAUTH_CLIENT_ID=${N8N_OAUTH_CLIENT_ID:-n8n-oauth-client}
N8N_OAUTH_CLIENT_SECRET=${N8N_OAUTH_CLIENT_SECRET:-change-me-n8n-oauth-secret}
AUTHENTIK_ISSUER=${AUTHENTIK_ISSUER:-http://auth.zoi.local/application/o/n8n-oauth}

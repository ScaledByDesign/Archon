# LiteLLM Proxy Environment Configuration
DOMAIN=zoi.local

# Authentication Keys (using recommended format from LiteLLM docs)
LITELLM_MASTER_KEY=sk-6df5295f77391ff7611a0fab11b989287012f48e46f58ae0

# SSO Configuration for Authentik Integration (Generic OAuth Provider)
GENERIC_CLIENT_ID=litellm-oauth-client
GENERIC_CLIENT_SECRET=${LITELLM_OAUTH_CLIENT_SECRET:-litellm-oauth-secret-2024-secure}
GENERIC_AUTHORIZATION_ENDPOINT=http://auth.zoi.local/application/o/authorize/
GENERIC_TOKEN_ENDPOINT=http://auth.zoi.local/application/o/token/
GENERIC_USERINFO_ENDPOINT=http://auth.zoi.local/application/o/userinfo/
GENERIC_SCOPE=openid profile email

# Proxy Base URL for SSO callbacks
PROXY_BASE_URL=http://llm.zoi.local

# External API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Salt Key for Encryption (permanent key for DB encryption)
LITELLM_SALT_KEY=sk-6df5295f77391ff7611a0fab11b989287012f48e46f58ae0

# UI Authentication
LITELLM_UI_PASSWORD=admin123

# Database Configuration (using in-memory mode for now)
DATABASE_URL=postgresql://postgres:litellm_password123@postgres:5432/litellm
STORE_MODEL_IN_DB=false

# Service Configuration
PORT=4000
HOST=0.0.0.0

# LiteLLM Settings (as strings to avoid type errors)
LITELLM_DROP_PARAMS=true
LITELLM_SET_VERBOSE=false
# Service Configuration
OPENWEBUI_HOST=openwebui.${DOMAIN:-zoi.local}
OPENWEBUI_PORT=8088
OPENWEBUI_PROTOCOL=http

# LiteLLM Integration
OPENAI_API_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-6df5295f77391ff7611a0fab11b989287012f48e46f58ae0

# Authentication Configuration
WEBUI_AUTH=${OPENWEBUI_AUTH:-false}
OPENWEBUI_USER=${OPENWEBUI_USER:-admin}

# OpenWebUI Configuration
# Generated: $(date)

# Service Configuration
OPENWEBUI_HOST=openwebui.${DOMAIN:-zoi.local}
OPENWEBUI_PORT=8088
OPENWEBUI_PROTOCOL=http

# Authentication (OAuth2 via Authentik)
OPENWEBUI_OAUTH_CLIENT_ID=${OPENWEBUI_OAUTH_CLIENT_ID:-openwebui-oauth-client}
OPENWEBUI_OAUTH_CLIENT_SECRET=${OPENWEBUI_OAUTH_CLIENT_SECRET:-change-me-openwebui-oauth-secret}
AUTHENTIK_ISSUER=${AUTHENTIK_ISSUER:-http://auth.zoi.local/application/o/openwebui-oauth}

# Timezone
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago

# Security
OPENWEBUI_SECURE_COOKIE=false
OPENWEBUI_SECURITY_AUDIT_DAYS=7 
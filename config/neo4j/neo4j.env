# Neo4j Configuration
DOMAIN=zoi.local

# Authentication Configuration
NEO4J_AUTH=neo4j/${NEO4J_PASSWORD:-neo4j123!}
NEO4J_ADMIN_PASSWORD=${NEO4J_PASSWORD:-neo4j123!}

# Database Configuration
NEO4J_dbms_default__database=neo4j
NEO4J_dbms_databases_default__to__read__only=false

# Memory Configuration
NEO4J_dbms_memory_heap_initial__size=512m
NEO4J_dbms_memory_heap_max__size=1G
NEO4J_dbms_memory_pagecache_size=512m

# Network Configuration
NEO4J_dbms_default__listen__address=0.0.0.0
NEO4J_dbms_default__advertised__address=localhost
NEO4J_dbms_connector_bolt_enabled=true
NEO4J_dbms_connector_bolt_listen__address=0.0.0.0:7687
NEO4J_dbms_connector_bolt_advertised__address=neo4j.zoi.local:7687
NEO4J_dbms_connector_http_enabled=true
NEO4J_dbms_connector_http_listen__address=0.0.0.0:7474
NEO4J_dbms_connector_http_advertised__address=neo4j.zoi.local:7474

# Security Configuration
NEO4J_dbms_security_procedures_unrestricted=gds.*,apoc.*
NEO4J_dbms_security_procedures_allowlist=gds.*,apoc.*

# APOC Configuration
NEO4J_dbms_unmanaged__extension__classes=n10s.endpoint=/rdf
NEO4J_apoc_export_file_enabled=true
NEO4J_apoc_import_file_enabled=true
NEO4J_apoc_import_file_use__neo4j__config=true

# Logging Configuration
NEO4J_dbms_logs_http_enabled=true
NEO4J_dbms_logs_query_enabled=INFO

# Performance Configuration
NEO4J_dbms_tx__log_rotation_retention__policy=1 days
NEO4J_dbms_checkpoint_interval_time=15m

# Plugins Configuration
NEO4JLABS_PLUGINS=["apoc", "graph-data-science"]

# Browser Configuration
NEO4J_browser_remote__content__hostname__whitelist=*
NEO4J_browser_post__connect__cmd=play movies

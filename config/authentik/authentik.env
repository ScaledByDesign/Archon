# Authentik Configuration
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

# Database Configuration (PostgreSQL)
AUTHENTIK_POSTGRESQL__HOST=authentik-db
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=secretpass
AUTHENTIK_POSTGRESQL__PORT=5432

# Redis Configuration
AUTHENTIK_REDIS__HOST=authentik-redis
AUTHENTIK_REDIS__PORT=6379
AUTHENTIK_REDIS__DB=0

# Email Configuration (for production)
AUTHENTIK_EMAIL__HOST=smtp.gmail.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=authentik@localhost

# OIDC Configuration
AUTHENTIK_AVATARS=gravatar,initials
AUTHENTIK_DEFAULT_USER_CHANGE_NAME=true
AUTHENTIK_DEFAULT_USER_CHANGE_EMAIL=true
AUTHENTIK_DEFAULT_USER_CHANGE_USERNAME=true

# Logging
AUTHENTIK_LOG_LEVEL=info

# Bootstrap Configuration
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-authentik-token
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost

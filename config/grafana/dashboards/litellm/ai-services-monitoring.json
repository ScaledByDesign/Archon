{
  "dashboard": {
    "id": null,
    "title": "AI Services Monitoring - LiteLLM, vLLM, Qdrant",
    "tags": ["ai", "llm", "vector", "services", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "🤖 LiteLLM Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"litellm\"}",
            "legendFormat": "LiteLLM",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "mappings": [
              {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "UP", "color": "green"}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "⚡ vLLM Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"vllm\"}",
            "legendFormat": "vLLM",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "mappings": [
              {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "UP", "color": "green"}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "🔍 Qdrant Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"qdrant\"}",
            "legendFormat": "Qdrant",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "mappings": [
              {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
              {"options": {"1": {"text": "UP", "color": "green"}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "🎯 Service Health Score",
        "type": "stat",
        "targets": [
          {
            "expr": "(up{job=\"vllm\"} + up{job=\"qdrant\"}) / 2 * 100",
            "legendFormat": "Health %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 80}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "vLLM Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vllm_request_success_total[5m])",
            "legendFormat": "Successful Requests/sec",
            "refId": "A"
          },
          {
            "expr": "rate(vllm_request_failure_total[5m])",
            "legendFormat": "Failed Requests/sec",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "vLLM Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(vllm_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(vllm_request_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Response Time (seconds)",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 7,
        "title": "Qdrant Collections",
        "type": "graph",
        "targets": [
          {
            "expr": "qdrant_collections_total",
            "legendFormat": "Total Collections",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Collections",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 8,
        "title": "Qdrant Vector Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(qdrant_rest_responses_total[5m])",
            "legendFormat": "REST API Requests/sec",
            "refId": "A"
          },
          {
            "expr": "rate(qdrant_grpc_responses_total[5m])",
            "legendFormat": "gRPC Requests/sec",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      },
      {
        "id": 9,
        "title": "AI Service Resource Usage",
        "type": "table",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\".*llm.*|.*qdrant.*\"} / 1024 / 1024",
            "legendFormat": "{{name}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "name": "Service",
                "Value": "Memory (MB)"
              }
            }
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20}
      }
    ]
  }
}

# Langfuse Configuration
DOMAIN=zoi.local

# Database Configuration
DATABASE_URL=postgresql://langfuse:${PG_PASS:-secretpass}@postgres:5432/langfuse

# ClickHouse Configuration (required for Langfuse v3)
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD:-langfuse123!}
CLICKHOUSE_DATABASE=langfuse

# Authentication Configuration
NEXTAUTH_SECRET=${LANGFUSE_NEXTAUTH_SECRET:-langfuse-nextauth-secret-2024-change-me}
NEXTAUTH_URL=http://langfuse.zoi.local

# Salt for hashing
SALT=${LANGFUSE_SALT:-langfuse-salt-2024-change-me}

# Encryption key for sensitive data (256-bit hex)
ENCRYPTION_KEY=26df3f0ae23bf9a491c331323533ea1d57ffdc20f2633f6b7783a5cea005f9a6

# Service Configuration
PORT=3000
HOSTNAME=0.0.0.0

# Feature Flags
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# Admin Configuration
LANGFUSE_INIT_ORG_ID=${LANGFUSE_ORG_ID:-zoi-org}
LANGFUSE_INIT_ORG_NAME=${LANGFUSE_ORG_NAME:-Zoi Organization}
LANGFUSE_INIT_PROJECT_ID=${LANGFUSE_PROJECT_ID:-zoi-project}
LANGFUSE_INIT_PROJECT_NAME=${LANGFUSE_PROJECT_NAME:-Zoi AI Project}
LANGFUSE_INIT_USER_EMAIL=${LANGFUSE_ADMIN_EMAIL:-admin@zoi.local}
LANGFUSE_INIT_USER_NAME=${LANGFUSE_ADMIN_NAME:-Admin}
LANGFUSE_INIT_USER_PASSWORD=${LANGFUSE_ADMIN_PASSWORD:-admin123!}

# API Configuration
LANGFUSE_DEFAULT_PROJECT_ID=${LANGFUSE_PROJECT_ID:-zoi-project}
LANGFUSE_DEFAULT_PROJECT_ROLE=OWNER

# Security Configuration
LANGFUSE_CSP_ENFORCE_HTTPS=false
LANGFUSE_ALLOWED_ORIGINS=http://langfuse.zoi.local,http://localhost:7071

# Telemetry (disable for privacy)
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_TELEMETRY=false

# Redis Configuration (for caching and sessions)
REDIS_CONNECTION_STRING=redis://redis:6379/3

# Email Configuration (optional)
EMAIL_FROM_ADDRESS=${LANGFUSE_EMAIL_FROM:-noreply@zoi.local}
SMTP_CONNECTION_URL=${LANGFUSE_SMTP_URL:-}

# S3 Configuration (optional for file uploads)
S3_ENDPOINT=${LANGFUSE_S3_ENDPOINT:-}
S3_ACCESS_KEY_ID=${LANGFUSE_S3_ACCESS_KEY:-}
S3_SECRET_ACCESS_KEY=${LANGFUSE_S3_SECRET_KEY:-}
S3_BUCKET_NAME=${LANGFUSE_S3_BUCKET:-}
S3_REGION=${LANGFUSE_S3_REGION:-}

# Logging Configuration
LOG_LEVEL=info
LANGFUSE_LOG_LEVEL=info

# Rate Limiting
LANGFUSE_RATE_LIMIT_ENABLED=true
LANGFUSE_RATE_LIMIT_PER_MINUTE=1000

# SuperAGI Environment Variables Template
# Copy this to config/superagi/.env

# Development Mode - REQUIRED for simplified authentication
ENV=DEV

# Qdrant Vector Database Configuration  
QDRANT_HOST_NAME=qdrant
QDRANT_PORT=6333

# LiteLLM Configuration
LITELLM_API_BASE=http://litellm:4000
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}

# OpenAI API Key for LiteLLM (use LiteLLM master key as proxy)
OPENAI_API_KEY=${LITELLM_MASTER_KEY}

# Database Configuration (should match config.yaml)
POSTGRES_URL=postgresql://superagi:password@postgres/superagi

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Other environment variables...
# Add any additional environment variables as needed

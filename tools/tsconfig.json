{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@dev-tools/*": ["dev-tools/*"],
      "@ai-tools/*": ["ai-tools/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "dev-tools", "ai-tools", "windsurf", "cursor", "mcp", "tasks", "prd", "docs"]
}

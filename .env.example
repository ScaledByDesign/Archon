# Domain Configuration
DOMAIN=zoi.local
ACME_EMAIL=admin@zoi.local

# Authentication
AUTHENTIK_SECRET_KEY=change-me-to-random-string-min-50-chars
AUTHENTIK_REDIS_PASS=change-me-redis-pass
PG_PASS=change-me-postgres-pass

# LLM Configuration
LITELLM_MASTER_KEY=sk-change-me-to-random-string
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Database Credentials
MONGO_USER=admin
MONGO_PASS=change-me-mongo-pass

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=change-me-rabbitmq-pass

# Redis
REDIS_PASSWORD=change-me-redis-pass

# n8n
N8N_USER=admin
N8N_PASS=change-me-n8n-pass
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-smtp-app-password
N8N_SMTP_SENDER=n8n@zoi.local
N8N_OAUTH_CLIENT_ID=n8n-oauth-client
N8N_OAUTH_CLIENT_SECRET=change-me-n8n-oauth-secret
AUTHENTIK_ISSUER=http://auth.zoi.local/application/o/n8n-oauth

# Email Configuration (for healthchecks)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Secret Keys
HC_SECRET_KEY=change-me-healthchecks-secret

# Gitness Configuration
GITNESS_PRINCIPAL_ADMIN_PASSWORD=change-me-gitness-admin-pass
GITNESS_PRINCIPAL_ADMIN_USER=admin@zoi.local

# AI Developer / SuperCoder Configuration (Optional)
AI_DEVELOPER_GITNESS_TOKEN=
AI_DEVELOPER_GITNESS_URL=http://supercoder-gitness:3000
AI_DEVELOPER_GITNESS_USER=admin
AI_DEVELOPER_GITNESS_HOST=supercoder-gitness:3000
AI_DEVELOPER_WORKSPACE_SERVICE_ENDPOINT=http://supercoder-ws:8080
AI_DEVELOPER_APP_URL=http://zoi.local:3002
AI_DEVELOPER_GITHUB_CLIENT_SECRET=
AI_DEVELOPER_GITHUB_CLIENT_ID=

# AWS Configuration (Optional - for SuperCoder S3 storage)
AI_DEVELOPER_AWS_ACCESS_KEY_ID=
AI_DEVELOPER_AWS_SECRET_ACCESS_KEY=
AI_DEVELOPER_AWS_REGION=
AI_DEVELOPER_FILESTORE_TYPE=local
AI_DEVELOPER_FILESTORE_S3_BUCKET=

# Workspace Configuration (Optional)
AI_DEVELOPER_WORKSPACE_TEMPLATE_DIR=
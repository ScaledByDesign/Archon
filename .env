# Domain Configuration
DOMAIN=zoi.cc
ACME_EMAIL=admin@zoi.cc

# Authentication
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters-long
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-authentik-bootstrap-token-32-chars
AUTHENTIK_BOOTSTRAP_EMAIL=admin@zoi.cc
AUTHENTIK_URL=https://auth.zoi.cc
AUTHENTIK_ISSUER=https://auth.zoi.cc/application/o/default/
AUTHENTIK_API_TOKEN=change-me-authentik-api-token-for-jwt-validation

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=86400
JWT_ID_TOKEN_LIFETIME=3600
JWT_ALGORITHM=RS256
JWT_AUDIENCE=rag-system
JWKS_CACHE_TTL=3600
JWT_CLOCK_SKEW_TOLERANCE=30
JWT_REQUIRE_EXP=true
JWT_REQUIRE_IAT=true
JWT_REQUIRE_NBF=false
JWT_VERIFY_SIGNATURE=true
JWT_VERIFY_AUDIENCE=true
JWT_VERIFY_ISSUER=true
JWT_MAX_AUTH_AGE=86400
JWT_PUBLIC_KEY=dummy_public_key_for_dev
JWT_PRIVATE_KEY=dummy_private_key_for_dev

# Token Storage Security
TOKEN_ENCRYPTION_KEY=change-me-to-a-secure-32-byte-key-for-token-encryption
MAX_TOKENS_PER_USER=10
MAX_CONCURRENT_SESSIONS=10

# OAuth2 Client Credentials (Generated after blueprint application)
FASTAPI_OAUTH_CLIENT_ID=fastapi-client
FASTAPI_OAUTH_CLIENT_SECRET=UG2JdK11FjQtseCQ4NMQxju2KasWSbDZFr4Glu57tWNJar9tHXPR7AkHBgWaMqXYqWEer2OuhaOqlU8hmGXLTczzqaNwBRC50D355B7T6C1bqanc4T75JR01spKsQHMT
